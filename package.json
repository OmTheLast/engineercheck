{
  "name": "engineercheck",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm --filter @engineercheck/dashboard dev",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "eval": "tsx packages/test-fixtures/src/evaluate.ts",
    "scan": "tsx apps/cli/src/index.ts scan",
    "dashboard": "tsx apps/cli/src/index.ts dashboard"
  },
  "devDependencies": {
    "@engineercheck/analyzer": "workspace:*",
    "@engineercheck/report-schema": "workspace:*",
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.0.15"
  }
}
